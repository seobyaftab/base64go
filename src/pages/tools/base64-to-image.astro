---
import Layout from '../../layouts/Layout.astro';

const toolTitle = 'Base64 to Image Decoder: PNG, JPG, WebP & SVG Previewer (Online)';
const toolDescription = 'Convert Base64 strings to images with auto-format detection (PNG, JPEG, WebP, GIF, SVG). Preview dimensions, zoom, and download files 100% locally in your browser.';
---

<Layout
  title={toolTitle}
  description={toolDescription}
  canonicalURL="https://base64go.com/tools/base64-to-image/"
>
  <main class="mx-auto max-w-[1200px] px-4 py-12 sm:px-6 lg:px-8">
    <div class="text-center mb-8">
      <div class="inline-flex items-center gap-1.5 rounded-full border border-link/20 bg-link-bg-soft/40 px-3 py-1 text-[12px] leading-4 text-link-deep font-medium mb-3">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        Auto-Sniffs PNG, JPG, WebP & SVG
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-semibold tracking-tight text-ink mb-3">
        <span class="bg-gradient-to-r from-link via-[#7928ca] to-[#ff0080] bg-clip-text text-transparent">Base64 to Image</span> Decoder
      </h1>
      <p class="max-w-2xl mx-auto text-base sm:text-lg text-body">
        Paste raw Base64 strings or Data URIs. The tool sniffs binary signatures, renders an instant image preview, and lets you download the original file.
      </p>
    </div>

    <base64-image-viewer class="block">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start mb-12">
        <!-- Input Panel -->
        <div class="lg:col-span-5 flex flex-col gap-4">
          <div class="flex items-center justify-between">
            <label for="img-input" class="text-xs uppercase font-mono tracking-wider text-mute font-bold">
              Base64 String or Data URI
            </label>
            <button id="btn-img-clear" type="button" class="text-xs text-mute hover:text-ink transition-colors font-mono cursor-pointer">
              Clear
            </button>
          </div>

          <textarea
            id="img-input"
            rows="14"
            placeholder="Paste Base64 image string (e.g. data:image/png;base64,iVBORw0KGgo... or raw iVBORw0...)"
            class="w-full resize-y rounded-xl border border-hairline bg-canvas p-4 text-xs sm:text-sm font-mono leading-relaxed text-ink placeholder:text-mute focus:outline-none focus:border-link min-h-[300px] lg:min-h-[460px] shadow-level-1"
            spellcheck="false"
          ></textarea>

          <div class="flex items-center gap-3">
            <button
              id="btn-img-sample"
              type="button"
              class="rounded-lg border border-hairline bg-canvas-soft-2 px-3 py-2 text-xs font-medium text-body hover:text-ink transition-colors cursor-pointer"
            >
              Load Sample PNG
            </button>
          </div>
        </div>

        <!-- Output & Image Viewer -->
        <div class="lg:col-span-7 flex flex-col gap-4">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="text-xs uppercase font-mono tracking-wider text-mute font-bold">Image Preview</span>
              <span id="img-format-badge" class="hidden text-[11px] font-mono px-2 py-0.5 rounded bg-link-bg-soft text-link-deep font-semibold">
                PNG
              </span>
            </div>
            <div class="flex items-center gap-2">
              <span id="img-dims-badge" class="text-xs font-mono text-mute">0 x 0 px</span>
              <a
                id="btn-img-download"
                download="decoded-image.png"
                class="pointer-events-none opacity-50 inline-flex items-center gap-1.5 rounded-lg bg-link px-3.5 py-1.5 text-xs font-semibold text-white shadow-level-1 hover:bg-link-deep transition-all cursor-pointer"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                Download Image
              </a>
            </div>
          </div>

          <!-- Preview Canvas Area -->
          <div class="relative w-full rounded-xl border border-hairline bg-[radial-gradient(#e5e7eb_1px,transparent_1px)] dark:bg-[radial-gradient(#27272a_1px,transparent_1px)] [background-size:16px_16px] min-h-[300px] lg:min-h-[460px] flex items-center justify-center p-6 overflow-hidden shadow-level-1">
            <div id="img-empty-state" class="text-center p-8 text-mute">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="mx-auto mb-3 opacity-40"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
              <p class="text-sm font-medium text-body">Paste a Base64 image string on the left</p>
              <p class="text-xs text-mute mt-1">Supports PNG, JPEG, WebP, GIF, and SVG formats.</p>
            </div>

            <div id="img-error-state" class="hidden text-center p-8 text-red-500">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mx-auto mb-2 text-red-400"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              <p id="img-error-msg" class="text-sm font-medium text-red-600 dark:text-red-400">Invalid Base64 Image</p>
            </div>

            <img
              id="img-element"
              class="hidden max-w-full max-h-[420px] object-contain rounded-lg shadow-level-2"
              alt="Decoded Base64 Preview"
            />
          </div>

          <!-- Format Information Table -->
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 text-xs font-mono">
            <div class="p-3 rounded-lg border border-hairline bg-canvas">
              <span class="text-mute block text-[11px] mb-0.5">MIME Type</span>
              <span id="stat-mime" class="font-bold text-ink">Unknown</span>
            </div>
            <div class="p-3 rounded-lg border border-hairline bg-canvas">
              <span class="text-mute block text-[11px] mb-0.5">Decoded File Size</span>
              <span id="stat-img-size" class="font-bold text-ink">0 KB</span>
            </div>
            <div class="p-3 rounded-lg border border-hairline bg-canvas col-span-2 sm:col-span-1">
              <span class="text-mute block text-[11px] mb-0.5">Aspect Ratio</span>
              <span id="stat-aspect" class="font-bold text-ink">N/A</span>
            </div>
          </div>
        </div>
      </div>
    </base64-image-viewer>

    <article class="prose max-w-none border-t border-hairline pt-12 text-body">
      <h2 class="text-2xl font-semibold text-ink mb-4">Magic Byte Signatures for Common Image Formats</h2>
      <p class="leading-relaxed mb-4">
        Every binary image standard begins with identifiable signature bytes. When checking Base64 strings, look for these common prefix patterns:
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 my-6 font-mono text-xs">
        <div class="p-4 rounded-xl border border-hairline bg-canvas">
          <strong class="font-sans text-sm text-ink block mb-1">PNG Format</strong>
          <div class="text-link font-bold">iVBORw0KGgo...</div>
          <div class="text-mute mt-1">Magic bytes: 89 50 4E 47</div>
        </div>
        <div class="p-4 rounded-xl border border-hairline bg-canvas">
          <strong class="font-sans text-sm text-ink block mb-1">JPEG / JPG Format</strong>
          <div class="text-link font-bold">/9j/4...</div>
          <div class="text-mute mt-1">Magic bytes: FF D8 FF</div>
        </div>
        <div class="p-4 rounded-xl border border-hairline bg-canvas">
          <strong class="font-sans text-sm text-ink block mb-1">WebP Format</strong>
          <div class="text-link font-bold">UklGR...</div>
          <div class="text-mute mt-1">Magic bytes: 52 49 46 46 (RIFF)</div>
        </div>
        <div class="p-4 rounded-xl border border-hairline bg-canvas">
          <strong class="font-sans text-sm text-ink block mb-1">GIF Format</strong>
          <div class="text-link font-bold">R0lGOD...</div>
          <div class="text-mute mt-1">Magic bytes: 47 49 46 38</div>
        </div>
      </div>
    </article>
  </main>
</Layout>

<script>
  class Base64ImageViewer extends HTMLElement {
    connectedCallback() {
      const input = this.querySelector('#img-input') as HTMLTextAreaElement;
      const btnClear = this.querySelector('#btn-img-clear');
      const btnSample = this.querySelector('#btn-img-sample');
      const img = this.querySelector('#img-element') as HTMLImageElement;
      const emptyState = this.querySelector('#img-empty-state');
      const errorState = this.querySelector('#img-error-state');
      const errorMsg = this.querySelector('#img-error-msg');
      const formatBadge = this.querySelector('#img-format-badge');
      const dimsBadge = this.querySelector('#img-dims-badge');
      const btnDownload = this.querySelector('#btn-img-download') as HTMLAnchorElement;
      const statMime = this.querySelector('#stat-mime');
      const statSize = this.querySelector('#stat-img-size');
      const statAspect = this.querySelector('#stat-aspect');

      const samplePng = 'data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAoAAAAKCAYAAACNMs+9AAAAFUlEQVR42mNk+M9QzwAEjDAGYzAKAwAE4wIBi2+bggAAAABJRU5ErkJggg==';

      const renderImage = (rawString: string) => {
        let cleaned = rawString.trim();

        if (!cleaned) {
          emptyState?.classList.remove('hidden');
          errorState?.classList.add('hidden');
          img?.classList.add('hidden');
          formatBadge?.classList.add('hidden');
          if (dimsBadge) dimsBadge.textContent = '0 x 0 px';
          if (statMime) statMime.textContent = 'Unknown';
          if (statSize) statSize.textContent = '0 KB';
          if (statAspect) statAspect.textContent = 'N/A';
          btnDownload?.classList.add('pointer-events-none', 'opacity-50');
          return;
        }

        // Sniff MIME type
        let mime = 'image/png';
        let ext = 'png';

        if (cleaned.startsWith('data:')) {
          const match = cleaned.match(/^data:([^;]+);base64,/);
          if (match) {
            mime = match[1];
            ext = mime.split('/')[1] || 'png';
          }
        } else {
          // Sniff magic bytes from raw base64
          if (cleaned.startsWith('iVBORw0KGgo')) { mime = 'image/png'; ext = 'png'; }
          else if (cleaned.startsWith('/9j/')) { mime = 'image/jpeg'; ext = 'jpg'; }
          else if (cleaned.startsWith('R0lGOD')) { mime = 'image/gif'; ext = 'gif'; }
          else if (cleaned.startsWith('UklGR')) { mime = 'image/webp'; ext = 'webp'; }
          else if (cleaned.startsWith('PHN2Zy') || cleaned.startsWith('<svg')) { mime = 'image/svg+xml'; ext = 'svg'; }
          else if (cleaned.startsWith('Qk')) { mime = 'image/bmp'; ext = 'bmp'; }

          cleaned = `data:${mime};base64,${cleaned.replace(/\s+/g, '')}`;
        }

        img.onload = () => {
          emptyState?.classList.add('hidden');
          errorState?.classList.add('hidden');
          img?.classList.remove('hidden');

          const w = img.naturalWidth;
          const h = img.naturalHeight;
          if (dimsBadge) dimsBadge.textContent = `${w} x ${h} px`;
          if (formatBadge) {
            formatBadge.textContent = ext.toUpperCase();
            formatBadge.classList.remove('hidden');
          }
          if (statMime) statMime.textContent = mime;
          if (statAspect) {
            const gcd = (a: number, b: number): number => (b === 0 ? a : gcd(b, a % b));
            const divisor = gcd(w, h);
            statAspect.textContent = divisor > 0 ? `${w / divisor}:${h / divisor}` : `${w}:${h}`;
          }

          // Approx size
          const base64Length = cleaned.split('base64,')[1]?.length || 0;
          const sizeKb = ((base64Length * 0.75) / 1024).toFixed(1);
          if (statSize) statSize.textContent = `${sizeKb} KB`;

          if (btnDownload) {
            btnDownload.href = cleaned;
            btnDownload.download = `decoded-image.${ext}`;
            btnDownload.classList.remove('pointer-events-none', 'opacity-50');
          }
        };

        img.onerror = () => {
          emptyState?.classList.add('hidden');
          img?.classList.add('hidden');
          formatBadge?.classList.add('hidden');
          errorState?.classList.remove('hidden');
          if (errorMsg) errorMsg.textContent = 'Invalid Base64 Image String';
          btnDownload?.classList.add('pointer-events-none', 'opacity-50');
        };

        img.src = cleaned;
      };

      input?.addEventListener('input', () => renderImage(input.value));

      btnClear?.addEventListener('click', () => {
        if (input) input.value = '';
        renderImage('');
      });

      btnSample?.addEventListener('click', () => {
        if (input) {
          input.value = samplePng;
          renderImage(samplePng);
        }
      });
    }
  }

  customElements.define('base64-image-viewer', Base64ImageViewer);
</script>
